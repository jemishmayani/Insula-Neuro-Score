 "calculationMethod": {
  "type": "sum",
  "notTestablePolicy": "block",
  "range": {
   "min": 0,
   "max": 60
  },
  "formula": "Left {left} + Right {right}",
  "display": "{total}/60",
  "share": "MRC-SS {total}/60 (L {left}, R {right})"
 },
 "notTestable": {
  "label": "No total: movement not testable",
  "summary": "At least one movement could not be tested, so no MRC sum score is reported.",
  "display": "No total",
  "detail": "Report the individual grades. A partial sum is not comparable with the 0–60 scale or the <48 threshold.",
  "share": "MRC-SS not reported (movement not testable)"
 },
 "interpretationRules": [
  {
   "when": "total == 60",
   "state": "full"
  },
  {
   "when": "total >= 48",
   "state": "above"
  },
  {
   "state": "below"
  }
 ],
 "resultStates": [
  {
   "id": "full",
   "tone": "favorable",
   "label": "No weakness measured",
   "summary": "Full strength in all 12 movements tested at this assessment.",
   "range": "60",
   "detail": "Does not exclude distal, proximal-axial or respiratory muscle weakness.",
   "min": 60,
   "max": 60
  },
  {
   "id": "above",
   "tone": "mild",
   "label": "Weakness above the ICU-AW threshold",
   "summary": "Some weakness, with a total at or above 48.",
   "range": "48–59",
   "detail": "The <48 threshold applies to ICU-acquired weakness; interpret other causes of weakness on their own terms.",
   "min": 48,
   "max": 59
  },
  {
   "id": "below",
   "tone": "high",
   "label": "Below 48: meets the ICU-AW strength criterion",
   "summary": "Total below 48, the strength criterion used to define ICU-acquired weakness (De Jonghe 2002).",
   "range": "0–47",
   "detail": "Assess for ICU-acquired weakness in clinical context; the diagnosis also requires exclusion of other causes, and the score alone does not establish it.",
   "min": 0,
   "max": 47
  }
 ],
 "clinicalContext": [
  {
   "text": "Summarises strength in 12 standard movements into one number.",
   "importance": "major"
  },
  {
   "text": "A total below 48 is the strength criterion in the definition of ICU-acquired weakness."
  }
 ],
 "clinicalInsights": [
  {
   "when": "abs(left - right) >= 6",
   "importance": "major",
   "text": "Marked side-to-side difference: a focal (central or peripheral) cause is more likely than generalised ICU-acquired weakness."
  },
  {
   "text": "Repeat after sedation is reduced; early totals in the ICU are often limited by arousal and cooperation."
  }
 ],
 "limitations": [
  {
   "importance": "major",
   "text": "Requires an awake, cooperative patient; often not testable early in critical illness."
  },
  "Insensitive to small changes within MRC grade 4.",
  "Does not test distal hand, neck, trunk or respiratory muscles.",
  "Inter-rater agreement is lower in the ICU than in outpatient settings."
 ],
 "confounders": [
  {
   "factor": "Sedation or delirium",
   "effect": "Reduces effort and cooperation."
  },
  {
   "factor": "Pain, lines and positioning",
   "effect": "Limit testing of some movements."
  },
  {
   "factor": "Pre-existing weakness or joint disease",
   "effect": "Lowers the total independent of the acute illness."
  }
 ],
 "whatItDoesNotTellYou": [
  "The cause of weakness (e.g. myopathy versus neuropathy).",
  "Respiratory muscle strength.",
  "Functional mobility."
 ],
 "guideSections": {
  "what": "The sum of MRC grades for shoulder abduction, elbow flexion, wrist extension, hip flexion, knee extension and ankle dorsiflexion on both sides (0–60).",
  "whenToUse": "Screening and monitoring for ICU-acquired weakness; global strength in Guillain-Barré syndrome and other generalised weakness.",
  "howToPerform": "Confirm the patient is awake and can follow commands. Grade each of the 12 movements with the MRC 0–5 scale. Record any movement that cannot be tested; no total is reported in that case.",
  "clinicalContext": "A summary of limb strength; identifying ICU-acquired weakness also needs clinical context and exclusion of other causes."
 },
 "sources": [
  {
   "citation": "Kleyweg RP, van der Meché FG, Schmitz PI. Interobserver agreement in the assessment of muscle strength and functional abilities in Guillain-Barré syndrome. Muscle Nerve. 1991;14(11):1103-1109."
  },
  {
   "citation": "De Jonghe B, Sharshar T, Lefaucheur JP, et al. Paresis acquired in the intensive care unit: a prospective multicenter study. JAMA. 2002;288(22):2859-2867."
  },
  {
   "citation": "Stevens RD, Marshall SA, Cornblath DR, et al. A framework for diagnosing and classifying intensive care unit-acquired weakness. Crit Care Med. 2009;37(10 Suppl):S299-S308."
  }
 ],
