 "version": {
  "label": "MRC sum score, 12 muscle groups (Kleyweg et al. 1991)",
  "detail": "Six movements on each side graded 0–5 with the MRC scale; total 0–60. The <48 threshold for ICU-acquired weakness is from De Jonghe et al. 2002."
 },
 "purpose": "Summarises global limb strength from 12 standard movements, for example when assessing ICU-acquired weakness.",
 "intendedPopulation": "Adults able to follow commands for voluntary strength testing, including critically ill patients once awake and cooperative.",
 "resultPresentation": {
  "type": "examination-grade",
  "typeLabel": "Global muscle strength",
  "meter": true
 },
 "calculatorNotice": {
  "tone": "info",
  "title": "Requires an awake, cooperative patient",
  "message": "If any movement cannot be tested, record it as not testable. No total is reported, because a partial sum is not comparable with the 0–60 scale."
 },
